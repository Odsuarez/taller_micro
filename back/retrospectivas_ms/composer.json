{
    "name": "oscar/retrospectivas-api",
    "description": "API de retrospectivas Scrum con Slim y Eloquent",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "illuminate/database": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "start": "@php -S 127.0.0.1:8000 -t public public/index.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
